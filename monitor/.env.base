# Grafana admin (override password per env).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Public URL for Grafana (cookies / redirects). Filled per env.
GRAFANA_ROOT_URL=

# Outbound proxy for Telegram contact points (Grafana has no NOTIFICATION_PROXY).
# Same EE SOCKS as tg_api TELEGRAM_PROXY / status NOTIFICATION_PROXY.
# Examples: socks5://host:1080  |  http://host:8080
# Leave empty when Telegram is reachable directly.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
# Keep Loki/Alloy on the Docker network direct (do not send via proxy).
NO_PROXY=loki,alloy,localhost,127.0.0.1,conversion_app
