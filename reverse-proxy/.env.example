# Inbound webhook hosts — A-records → this EE VPS. Clients use :8443 (not :443 / Xray).
WEBHOOK_HOST_PROD=tg-hook.nambapp.ru
WEBHOOK_HOST_DEV=tg-hook.dev.nambapp.ru

# Where EE Traefik forwards to RF tg_api (public IP is fine — no WireGuard required).
# MUST reach the real app/Traefik. Do NOT use https://tg.*:443 — on RF :443 is Xray→Google.
# Typical: http://<RF_PUBLIC_IP>:8000 (publish tg_api, firewall allow only this EE IP).
BACKEND_URL_PROD=http://37.140.241.61:8000
BACKEND_URL_DEV=http://31.76.84.230:8000

# Host header for RF Traefik Host(APP_HOST) (tg_api APP_HOST).
BACKEND_HOST_PROD=tg.nambapp.ru
BACKEND_HOST_DEV=tg.dev.nambapp.ru

# Let's Encrypt account email (cert for WEBHOOK_HOST_* on EE :8443)
ACME_EMAIL=you@example.com
