# Domain A-record → this EE VPS public IP
WEBHOOK_HOST=tg-hook.nambapp.ru

# Where Traefik forwards Telegram webhooks (RF backend).
# Prefer WireGuard/private IP, e.g. http://10.8.0.2:8000
# Public RF HTTPS also works if reachable from this VPS.
BACKEND_URL=http://10.8.0.2:8000

# Let's Encrypt account email
ACME_EMAIL=you@example.com
