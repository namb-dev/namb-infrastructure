http:
  routers:
    tg-webhook-prod:
      rule: "Host(`{{WEBHOOK_HOST_PROD}}`) && PathPrefix(`/api/webhook`)"
      entryPoints:
        - https
      service: tg-api-prod
      tls:
        certResolver: letsencrypt

    tg-webhook-dev:
      rule: "Host(`{{WEBHOOK_HOST_DEV}}`) && PathPrefix(`/api/webhook`)"
      entryPoints:
        - https
      service: tg-api-dev
      tls:
        certResolver: letsencrypt

  services:
    # passHostHeader: false — RF Traefik matches Host(APP_HOST), not tg-hook.*
    tg-api-prod:
      loadBalancer:
        passHostHeader: false
        servers:
          - url: "{{BACKEND_URL_PROD}}"

    tg-api-dev:
      loadBalancer:
        passHostHeader: false
        servers:
          - url: "{{BACKEND_URL_DEV}}"
